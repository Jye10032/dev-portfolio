---
import "../styles/layout.css";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import type { MarkdownHeading } from "astro";

interface BlogFrontmatter {
	title?: string;
	description?: string;
	author?: string;
	date?: string;
	readingTime?: string;
	tags?: string[];
}

const { frontmatter, headings } = Astro.props as {
	frontmatter?: BlogFrontmatter;
	headings?: MarkdownHeading[];
};

const postFrontmatter: BlogFrontmatter = frontmatter ?? {};
const tags: string[] = Array.isArray(postFrontmatter.tags) ? postFrontmatter.tags : [];
const tocHeadings = (headings ?? []).filter((heading) => heading.depth <= 3);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{postFrontmatter.title ?? "博客文章"}</title>
	</head>
	<body>
		<div class="layout">
			<aside class="column column--left">
				<div class="post-meta">
					<h2 class="post-meta__heading">文章信息</h2>
					{postFrontmatter.author && <p class="post-meta__item">作者：{postFrontmatter.author}</p>}
					{postFrontmatter.date && (
						<p class="post-meta__item">
							发布日期：<time datetime={postFrontmatter.date}>{postFrontmatter.date}</time>
						</p>
					)}
					{postFrontmatter.readingTime && (
						<p class="post-meta__item">预计阅读：{postFrontmatter.readingTime}</p>
					)}
					{tags.length > 0 && (
						<div class="post-meta__tags" role="list">
							{tags.map((tag) => (
								<span class="post-meta__tag" role="listitem">#{tag}</span>
							))}
						</div>
					)}
					{!postFrontmatter.author && !postFrontmatter.date && !postFrontmatter.readingTime && tags.length === 0 && (
						<p class="post-meta__empty">使用 frontmatter 设置作者、日期或标签。</p>
					)}
				</div>
			</aside>
			<main class="column column--center">
				<Header />
				<article class="blog-article">
					{postFrontmatter.title && <h1 class="blog-article__title">{postFrontmatter.title}</h1>}
					{postFrontmatter.description && <p class="blog-article__description">{postFrontmatter.description}</p>}
					<div class="blog-article__content">
						<slot />
					</div>
				</article>
                <Footer />
			</main>
			<aside class="column column--right">
				<nav class="toc" aria-label="文章目录">
					<h2 class="toc__title">目录</h2>
					{tocHeadings.length ? (
						<ol class="toc__list">
							{tocHeadings.map((heading) => (
								<li class={`toc__item toc__item--depth-${heading.depth}`}>
									<a href={`#${heading.slug}`} class="toc__link">{heading.text}</a>
								</li>
							))}
						</ol>
					) : (
						<p class="toc__empty">为正文添加二级或三级标题以生成目录。</p>
					)}
				</nav>
			</aside>
		</div>
	</body>
</html>
