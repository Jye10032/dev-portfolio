---
import siteConfig from '../data/site-config';

const navLinks = siteConfig.footerNavLinks ?? [];
const socialLinks = siteConfig.socialLinks ?? [];
const year = new Date().getFullYear();

const isExternal = (href: string) => /^https?:\/\//i.test(href);
---

<footer class="site-footer mx-auto w-full max-w-3xl">
    {
        navLinks.length > 0 && (
            <nav class="site-footer__nav" aria-label="页脚导航">
                {navLinks.map((link) => (
                    <a class="site-footer__nav-link" href={link.href}>
                        {link.text}
                    </a>
                ))}
            </nav>
        )
    }

    <div class:list={['site-footer__base', socialLinks.length > 0 && 'site-footer__base--split']}>
        {
            socialLinks.length > 0 && (
                <div class="site-footer__social">
                    {socialLinks.map((link) => (
                        <a
                            class="site-footer__social-link"
                            href={link.href}
                            target={isExternal(link.href) ? '_blank' : undefined}
                            rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
                        >
                            {link.text}
                        </a>
                    ))}
                </div>
            )
        }
        <p class="site-footer__legal">
            &copy; {year} <a href="/">{siteConfig.title}</a>。持续更新中。
        </p>
    </div>
</footer>

<style>
    .site-footer {
        padding: 3rem 0 2.5rem;
    }

    @media (min-width: 40rem) {
        .site-footer {
            padding: 6rem 0 3.5rem;
        }
    }

    .site-footer__nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.5rem;
        margin-bottom: 1rem;
    }

    .site-footer__nav-link {
        font-family: var(--font-serif);
    }

    .site-footer__base {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        border-top: 1px dashed var(--border-main);
        padding-top: 1.5rem;
    }

    @media (min-width: 40rem) {
        .site-footer__base--split {
            flex-direction: row-reverse;
            align-items: center;
            justify-content: space-between;
        }
    }

    .site-footer__social {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1rem;
    }

    .site-footer__social-link,
    .site-footer__legal {
        font-size: 0.875rem;
    }
</style>
