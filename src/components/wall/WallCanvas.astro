---

---

<div class="wall-canvas relative min-h-[70vh] rounded-lg border border-main/10">
    <div class="absolute top-3 left-3 z-50 flex gap-2">
        <button
            id="wall-add"
            type="button"
            class="rounded-md border border-dashed border-main/30 bg-main/70 px-3 py-1.5 text-sm text-main/70 backdrop-blur transition-colors hover:border-(--accent) hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--accent)"
        >
            + 新建
        </button>
        <button
            id="wall-reset"
            type="button"
            class="rounded-md border border-main/15 bg-main/70 px-3 py-1.5 text-sm text-main/55 backdrop-blur transition-colors hover:border-main/35 hover:text-main focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--accent)"
        >
            重置墙
        </button>
    </div>
    <div id="wall-notes" class="absolute inset-0 overflow-hidden rounded-lg"></div>
</div>

<style>
    /* 点阵画布背景 */
    .wall-canvas {
        background-image: radial-gradient(circle, var(--bg-muted) 1px, transparent 1px);
        background-size: 24px 24px;
    }

    /* 便签基础样式:便签 DOM 由客户端动态渲染,需要 :global 穿透 */
    :global(.wall-note) {
        position: absolute;
        top: 0;
        left: 0;
        padding: 1rem;
        border-radius: 0.375rem;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
        color: var(--note-text);
        cursor: grab;
        user-select: none;
        touch-action: none;
        white-space: pre-wrap;
        overflow-wrap: break-word;
    }

    :global(.wall-note):focus {
        outline: none;
    }

    :global(.wall-note):focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    :global(.wall-note[data-size='sm']) {
        width: 10rem;
        font-size: 0.875rem;
        line-height: 1.5;
    }

    :global(.wall-note[data-size='md']) {
        width: 14rem;
        font-size: 1rem;
        line-height: 1.6;
    }

    :global(.wall-note[data-size='lg']) {
        width: 18rem;
        font-size: 1.125rem;
        line-height: 1.6;
    }

    :global(.wall-note[data-color='yellow']) {
        background-color: var(--note-yellow);
    }

    :global(.wall-note[data-color='mint']) {
        background-color: var(--note-mint);
    }

    :global(.wall-note[data-color='blue']) {
        background-color: var(--note-blue);
    }

    :global(.wall-note[data-color='coral']) {
        background-color: var(--note-coral);
    }

    :global(.wall-note[data-color='lavender']) {
        background-color: var(--note-lavender);
    }

    :global(.wall-note[data-color='cream']) {
        background-color: var(--note-cream);
    }

    /* 纹理样式 */
    :global(.wall-note[data-style='lined']) {
        background-image: repeating-linear-gradient(transparent, transparent 1.55em, rgb(0 0 0 / 0.08) 1.55em, rgb(0 0 0 / 0.08) calc(1.55em + 1px));
    }

    :global(.wall-note[data-style='grid']) {
        background-image:
            repeating-linear-gradient(transparent, transparent 23px, rgb(0 0 0 / 0.06) 23px, rgb(0 0 0 / 0.06) 24px),
            repeating-linear-gradient(90deg, transparent, transparent 23px, rgb(0 0 0 / 0.06) 23px, rgb(0 0 0 / 0.06) 24px);
    }

    :global(.wall-note[data-style='taped']::before) {
        content: '';
        position: absolute;
        top: -0.6rem;
        left: 50%;
        width: 5rem;
        height: 1.4rem;
        transform: translateX(-50%) rotate(-2deg);
        background: rgb(255 255 255 / 0.45);
        border: 1px solid rgb(0 0 0 / 0.05);
        border-radius: 2px;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
        pointer-events: none;
    }

    /* 选中态:accent 描边 + 加深阴影 */
    :global(.wall-note.is-selected) {
        box-shadow: 0 4px 10px rgb(0 0 0 / 0.14);
        outline: 2px solid var(--accent);
        outline-offset: 1px;
    }

    :global(.wall-note__icon) {
        position: absolute;
        top: -0.6rem;
        right: -0.4rem;
        font-size: 1.1rem;
        line-height: 1;
        pointer-events: none;
    }

    :global(.wall-note__content) {
        min-height: 2.5em;
    }

    :global(.wall-note__content[contenteditable='true']) {
        cursor: text;
        user-select: text;
        outline: none;
    }
</style>
