---
import { type CollectionEntry } from 'astro:content';
import ArrowRight from '../assets/icons/arrow-right.svg';

type Props = { project: CollectionEntry<'projects'>; class?: string; headingLevel?: 'h2' | 'h3' };

const { project, class: className, headingLevel = 'h2' } = Astro.props;
const { title, description } = project.data;
const TitleTag = headingLevel;
---

<a class:list={['project-preview', className]} href={`/projects/${project.id}/`}>
    <div class="project-preview__body">
        <TitleTag class="project-preview__title">{title}</TitleTag>
        {description && <p class="project-preview__description">{description}</p>}
    </div>
    <span class="project-preview__cue" aria-hidden="true">
        查看项目 <ArrowRight class="project-preview__icon" />
    </span>
</a>

<style>
    .project-preview {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 2rem;
        text-decoration: none;
    }

    .project-preview:hover {
        text-decoration: none;
    }

    .project-preview__body {
        flex-grow: 1;
        min-width: 0;
    }

    .project-preview__title {
        font-family: var(--font-serif);
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.3;
    }

    @media (min-width: 40rem) {
        .project-preview__title {
            font-size: 1.5rem;
        }
    }

    .project-preview:hover .project-preview__title,
    .project-preview:focus-visible .project-preview__title {
        text-decoration: underline dashed;
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
    }

    .project-preview__description {
        margin-top: 0.25rem;
        font-size: 0.875rem;
        line-height: 1.5;
    }

    .project-preview__cue {
        display: none;
        font-family: var(--font-serif);
        font-style: italic;
        opacity: 0;
        transition: opacity 180ms ease;
    }

    @media (min-width: 40rem) {
        .project-preview__cue {
            display: inline-flex;
            flex: none;
            align-items: center;
            gap: 0.25rem;
        }
    }

    .project-preview:hover .project-preview__cue,
    .project-preview:focus-visible .project-preview__cue {
        opacity: 1;
    }

    .project-preview__cue :global(.project-preview__icon) {
        height: 1rem;
        width: 1rem;
        fill: currentColor;
    }
</style>
