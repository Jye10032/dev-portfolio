---
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import siteConfig from '../data/site-config';
import type { ImageInput } from '../types';

import '../styles/global.css';

export type Props = {
    title?: string;
    description?: string;
    image?: ImageInput | undefined;
    pageType?: 'website' | 'article';
    alternates?: Array<{ lang: 'zh-CN' | 'en'; href: string }>;
};

const { title: pageTitle, description = '', image: pageImage, pageType = 'website', alternates = [] } = Astro.props;

const documentTitle = [pageTitle, siteConfig.title].filter(Boolean).join(' | ');

/** Canonical URLs always carry a trailing slash, except when query params are present. */
function canonicalise(url: string | URL): string {
    const value = url.toString();
    return value.includes('?') ? value.replace(/\/+$/, '') : value.replace(/\/?$/, '/');
}

const canonicalHref = canonicalise(new URL(Astro.request.url, Astro.site));

/** Local imports get resized to the OG 1200x630 ratio; plain strings pass through. */
async function resolveShareImage(input?: ImageInput) {
    if (!input?.src) return undefined;

    if (typeof input.src === 'string') {
        return { src: new URL(input.src, Astro.site).toString(), alt: input.alt };
    }

    const optimised = await getImage({
        src: input.src as ImageMetadata,
        width: 1200,
        height: 630,
        format: 'jpg',
        fit: 'cover'
    });
    return { src: new URL(optimised.src, Astro.site).toString(), alt: input.alt };
}

const shareImage = await resolveShareImage(pageImage ?? siteConfig.image);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{documentTitle}</title>
<meta name="generator" content={Astro.generator} />

<link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin="anonymous" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" href="/rss.xml" title="RSS" />

<link rel="canonical" href={canonicalHref} />
{alternates.map(({ lang, href }) => <link rel="alternate" hreflang={lang} href={canonicalise(new URL(href, Astro.site))} />)}

<meta name="description" content={description} />

<meta property="og:type" content={pageType} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:title" content={documentTitle} />
{description && <meta property="og:description" content={description} />}
{shareImage && <meta property="og:image" content={shareImage.src} />}
{shareImage?.alt && <meta property="og:image:alt" content={shareImage.alt} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalHref} />
<meta name="twitter:title" content={documentTitle} />
{description && <meta name="twitter:description" content={description} />}
{shareImage && <meta name="twitter:image" content={shareImage.src} />}
{shareImage?.alt && <meta name="twitter:image:alt" content={shareImage.alt} />}
