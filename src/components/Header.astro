---
import siteConfig from '../data/site-config';
import CustomImage from './CustomImage.astro';
---

<header class="border-main mx-auto mb-12 flex w-full max-w-3xl items-center gap-4 border-b pt-6 pb-6 sm:mb-16 sm:pt-8">
    {
        siteConfig.avatar?.src && (
            <a href="/" aria-label="返回首页">
                <CustomImage
                    class="border-main aspect-square w-16 border object-cover"
                    {...siteConfig.avatar}
                    loading="eager"
                    fetchpriority="high"
                    width={80}
                    height={80}
                    widths={[80, 160]}
                    sizes="80px"
                />
            </a>
        )
    }
    <div>
        <p class="text-2xl leading-tight font-bold sm:text-3xl"><a href="/">{siteConfig.title}</a></p>
        {siteConfig.subtitle && <p class="mt-1 text-sm leading-tight">{siteConfig.subtitle}</p>}
    </div>
</header>
