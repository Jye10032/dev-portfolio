---
import type { HTMLAttributes } from 'astro/types';

/** Renders an `<a>` when `href` is given, otherwise a `<button>`. */
type Props = (HTMLAttributes<'a'> & { href: string }) | (HTMLAttributes<'button'> & { href?: undefined });

const { href, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag class:list={['ui-button', className]} href={href} {...rest}>
    <slot />
</Tag>

<style>
    .ui-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border-main);
        background-color: transparent;
        padding: 0.375rem 0.75rem;
        font-family: var(--font-sans);
        line-height: 1.25;
        color: var(--text-main);
        text-decoration: none;
        cursor: pointer;
        transition:
            background-color 160ms ease,
            color 160ms ease;
    }

    .ui-button:hover,
    .ui-button:focus-visible {
        background-color: var(--text-main);
        color: var(--bg-main);
        text-decoration: none;
    }

    .ui-button:focus-visible {
        outline: 2px solid var(--border-main);
        outline-offset: 2px;
    }
</style>
