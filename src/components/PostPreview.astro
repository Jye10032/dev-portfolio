---
import { type CollectionEntry } from 'astro:content';
import ArrowRight from '../assets/icons/arrow-right.svg';
import FormattedDate from './FormattedDate.astro';

type Props = {
    post: CollectionEntry<'blog'>;
    class?: string;
    headingLevel?: 'h2' | 'h3';
    featured?: boolean;
};

const { post, class: className, headingLevel = 'h2', featured = false } = Astro.props;
const { title, publishDate, updatedDate, excerpt, type } = post.data;
const TitleTag = headingLevel;
const typeLabel = type === 'article' ? '长文' : '札记';
---

<a class:list={['group flex items-start justify-between gap-8', className]} href={`/blog/${post.id}/`}>
    <div class="grow">
        <div class="flex items-center gap-3">
            <TitleTag
                class:list={[
                    'font-serif leading-tight font-medium group-hover:underline group-hover:decoration-dashed group-hover:decoration-1 group-hover:underline-offset-4',
                    featured ? 'text-2xl sm:text-3xl' : 'text-xl sm:text-2xl'
                ]}
            >
                {title}
            </TitleTag>
            <span class="text-xs text-main/60 border border-main/20 rounded px-1.5 py-0.5 shrink-0">
                {typeLabel}
            </span>
        </div>
        <div class="mt-1 text-sm leading-normal text-main/70">
            <FormattedDate date={publishDate} />
            {
                updatedDate && (
                    <>
                        {' '}
                        <span>
                            (更新于 <FormattedDate date={updatedDate} />)
                        </span>
                    </>
                )
            }
        </div>
        {excerpt && <div class:list={['mt-3 leading-normal', featured ? 'text-base' : 'text-sm']}>{excerpt}</div>}
    </div>
    <div class="hidden font-serif italic opacity-0 transition group-hover:opacity-100 sm:inline-flex sm:shrink-0 sm:items-center sm:gap-1">
        阅读全文 <ArrowRight class="h-4 w-4 fill-current" />
    </div>
</a>
