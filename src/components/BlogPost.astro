---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from './Button.astro';
import FormattedDate from './FormattedDate.astro';
import PostPreview from './PostPreview.astro';
import PostSeries from './PostSeries.astro';
import { getPostHref, type PostSeriesData } from '../utils/data-utils';
import { slugify } from '../utils/common-utils';

type Heading = { depth: number; slug: string; text: string };

type Props = {
    post: CollectionEntry<'blog'>;
    series?: PostSeriesData;
    prevPost: CollectionEntry<'blog'> | null;
    nextPost: CollectionEntry<'blog'> | null;
    translation?: CollectionEntry<'blog'>;
    headings: Heading[];
};

const { post, series, prevPost, nextPost, translation, headings } = Astro.props;
const { title, displayTitle, publishDate, updatedDate, excerpt, tags = [], seo, type, readingTime, lang } = post.data;
const tableOfContents = type === 'article' ? headings.filter((heading) => heading.depth === 2) : [];
const showTableOfContents = tableOfContents.length >= 3;
const isEnglish = lang === 'en';
const labels = isEnglish
    ? {
          article: 'Article',
          note: 'Note',
          minutes: (value: number) => `${value} min read`,
          updated: 'Updated',
          toc: 'On this page',
          continueReading: 'Continue reading',
          share: 'Share',
          copied: 'Copied',
          topics: 'Topics'
      }
    : {
          article: '长文',
          note: '札记',
          minutes: (value: number) => `约 ${value} 分钟`,
          updated: '更新于',
          toc: '本文目录',
          continueReading: '继续阅读',
          share: '分享',
          copied: '已复制',
          topics: '文章主题'
      };
const typeLabel = type === 'article' ? labels.article : labels.note;
// Newer post first. Built here rather than in the template because Astro's
// markup expressions are parsed without TypeScript annotations.
const relatedPosts = [nextPost, prevPost].filter((entry): entry is CollectionEntry<'blog'> => Boolean(entry));
const alternates = translation
    ? [
          { lang, href: getPostHref(post) },
          { lang: translation.data.lang, href: getPostHref(translation) }
      ]
    : [];
---

<BaseLayout
    title={seo?.title ?? title}
    description={seo?.description ?? excerpt}
    image={seo?.image}
    pageType="article"
    wide={showTableOfContents}
    lang={lang}
    alternates={alternates}
>
    {
        type === 'article' && (
            <div class="bg-muted fixed top-0 left-0 z-50 h-0.5 w-full">
                <div id="reading-progress" class="bg-accent h-full transition-all duration-150" style="width: 0%" />
            </div>
        )
    }

    <div class:list={['post-layout', showTableOfContents && 'post-layout--with-toc']} data-blog-reading>
        <article class="post-article mb-16 sm:mb-24">
            <header class="mb-8">
                {
                    series && (
                        <p class="post-series-kicker">
                            <a href="#post-series" data-astro-reload>
                                {series.title} · {isEnglish ? `Part ${series.order}` : `第 ${series.order} 篇`}
                                <span aria-hidden="true"> ↓</span>
                            </a>
                        </p>
                    )
                }
                <div class="mb-4 flex flex-wrap items-center gap-3">
                    <span class="border-main border px-2 py-1 text-xs opacity-60">{typeLabel}</span>
                    {readingTime && <span class="text-main/60 text-xs">{labels.minutes(readingTime)}</span>}
                    {
                        translation && (
                            <nav class="post-language-switch" aria-label={isEnglish ? 'Language' : '语言'}>
                                <a href={getPostHref(translation)} lang={translation.data.lang} hreflang={translation.data.lang}>
                                    {translation.data.lang === 'en' ? 'EN' : '中文'}
                                </a>
                            </nav>
                        )
                    }
                </div>
                <h1 class="post-title">{displayTitle ?? title}</h1>
                <div class="text-main/70 mt-4 text-sm">
                    <FormattedDate date={publishDate} lang={lang} />
                    {
                        updatedDate && (
                            <>
                                {' '}
                                <span>
                                    ({labels.updated} <FormattedDate date={updatedDate} lang={lang} />)
                                </span>
                            </>
                        )
                    }
                </div>
            </header>

            {
                showTableOfContents && (
                    <details class="post-toc post-toc--compact">
                        <summary>
                            {labels.toc}
                            <span data-toc-current aria-hidden="true" />
                        </summary>
                        <ol>
                            {tableOfContents.map((heading) => (
                                <li>
                                    <a href={`#${heading.slug}`} data-astro-reload>
                                        {heading.text}
                                    </a>
                                </li>
                            ))}
                        </ol>
                    </details>
                )
            }

            <div class="post-content prose sm:prose-lg max-w-none">
                <slot />
            </div>
            <div class="mt-8 flex flex-wrap items-center justify-between gap-6 text-sm sm:mt-12 sm:text-base">
                {
                    tags.length > 0 && (
                        <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm" aria-label={labels.topics}>
                            {tags.map((tag) => (isEnglish ? <span>#{tag}</span> : <a href={`/tags/${slugify(tag)}`}>#{tag}</a>))}
                        </div>
                    )
                }
                <Button
                    data-share-url={Astro.url.href}
                    data-share-idle={labels.share}
                    data-share-done={labels.copied}
                    aria-live="polite"
                    aria-label={labels.share}
                >
                    {labels.share}
                </Button>
            </div>
            {series && <PostSeries {series} {lang} />}
        </article>

        {
            showTableOfContents && (
                <aside class="post-toc post-toc--desktop" aria-label={labels.toc}>
                    <p>{labels.toc}</p>
                    <ol>
                        {tableOfContents.map((heading) => (
                            <li>
                                <a href={`#${heading.slug}`} data-astro-reload>
                                    {heading.text}
                                </a>
                            </li>
                        ))}
                    </ol>
                </aside>
            )
        }
    </div>

    <div class="post-after mx-auto max-w-3xl">
        {
            !series && relatedPosts.length > 0 && (
                <nav class="post-related" aria-label={labels.continueReading}>
                    <h2 class="post-related__title">{labels.continueReading}</h2>
                    <ol class="post-related__list">
                        {relatedPosts.map((entry) => (
                            <li>
                                <PostPreview post={entry} headingLevel="h3" />
                            </li>
                        ))}
                    </ol>
                </nav>
            )
        }
    </div>
</BaseLayout>

<script>
    import '../scripts/blog-reading';
</script>

<style>
    .post-layout {
        max-width: 48rem;
        margin-inline: auto;
    }

    .post-layout--with-toc {
        display: grid;
        grid-template-columns: minmax(0, 48rem) 14rem;
        align-items: start;
        gap: clamp(1.5rem, 3vw, 3rem);
        max-width: 65rem;
    }

    .post-title {
        font-family: var(--font-sans);
        font-size: clamp(1.875rem, 3vw, 2.5rem);
        font-weight: 700;
        line-height: 1.3;
        text-wrap: pretty;
    }

    .post-series-kicker {
        margin-bottom: 1rem;
        color: var(--accent-muted);
        font-size: 0.8125rem;
    }

    .post-series-kicker a {
        text-decoration: none;
    }

    .post-series-kicker a:hover {
        text-decoration: underline;
        text-underline-offset: 0.25em;
    }

    .post-content :global(h2) {
        scroll-margin-top: 5rem;
    }

    .post-article {
        min-width: 0;
    }

    .post-related {
        margin: 4rem 0;
    }

    @media (min-width: 40rem) {
        .post-related {
            margin: 6rem 0;
        }
    }

    .post-related__title {
        margin-bottom: 3rem;
        font-family: var(--font-sans);
        font-size: 1.5rem;
        font-weight: 700;
    }

    @media (min-width: 40rem) {
        .post-related__title {
            margin-bottom: 4rem;
            font-size: 1.875rem;
        }
    }

    .post-related__list {
        display: grid;
        gap: 2.5rem;
        list-style: none;
    }

    @media (min-width: 40rem) {
        .post-related__list {
            gap: 3rem;
        }
    }

    .post-language-switch {
        margin-left: auto;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .post-toc {
        font-size: 0.8125rem;
        line-height: 1.45;
    }

    .post-toc--desktop {
        position: sticky;
        top: 2rem;
        grid-column: 2;
        max-height: calc(100svh - 4rem);
        overflow-y: auto;
        padding-left: 1rem;
        border-left: 1px solid color-mix(in srgb, var(--border-main) 24%, transparent);
    }

    .post-toc--desktop > p {
        margin: 0 0 0.75rem;
        font-weight: 700;
    }

    .post-toc ol {
        display: grid;
        gap: 0.55rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .post-toc li {
        position: relative;
    }

    .post-toc a {
        opacity: 0.68;
    }

    .post-toc a:hover,
    .post-toc a:focus-visible,
    .post-toc a[aria-current='location'] {
        opacity: 1;
    }

    .post-toc a[aria-current='location'] {
        font-weight: 700;
    }

    .post-toc--desktop a[aria-current='location']::before {
        position: absolute;
        top: 0.2em;
        bottom: 0.2em;
        left: -1.05rem;
        width: 2px;
        background: var(--text-main);
        content: '';
    }

    .post-toc--compact {
        display: none;
        position: sticky;
        top: 0;
        z-index: 10;
        margin-bottom: 2rem;
        padding-block: 0.75rem;
        border-block: 1px solid color-mix(in srgb, var(--border-main) 24%, transparent);
        background: var(--bg-main);
    }

    .post-toc--compact summary {
        cursor: pointer;
        font-weight: 700;
    }

    .post-toc--compact summary span {
        display: inline-block;
        max-width: calc(100% - 7rem);
        margin-left: 1rem;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: bottom;
        white-space: nowrap;
        color: var(--accent-muted);
        font-weight: 400;
    }

    .post-toc--compact[open] summary {
        margin-bottom: 0.75rem;
    }

    .post-toc--compact ol {
        max-height: min(60svh, 24rem);
        overflow-y: auto;
    }

    .post-toc--compact a {
        display: block;
        padding-block: 0.5rem;
    }

    @media (max-width: 63.999rem) {
        .post-layout--with-toc {
            display: block;
            max-width: 48rem;
        }

        .post-toc--desktop {
            display: none;
        }

        .post-toc--compact {
            display: block;
        }
    }
</style>
