---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...rest } = Astro.props;

/** Trailing slashes differ between dev and build output, so normalise both sides. */
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const linkPath = String(href ?? '').replace(/\/+$/, '') || '/';
const isCurrent = linkPath === currentPath;
---

<a class:list={['nav-link', className]} href={href} aria-current={isCurrent ? 'page' : undefined} {...rest}>
    <slot />
</a>

<style>
    .nav-link[aria-current='page'] {
        font-weight: 700;
        text-decoration: none;
    }
</style>
