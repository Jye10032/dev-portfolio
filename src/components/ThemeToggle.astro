---
// Renders the control only. Theme switching lives in `public/theme-toggle.js`
// so it can run before first paint without flashing the wrong palette.
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="切换配色模式">
    <span class="theme-toggle__dot" aria-hidden="true"></span>
</button>

<style>
    .theme-toggle {
        display: inline-flex;
        height: 2rem;
        width: 2rem;
        margin-right: -0.5rem;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .theme-toggle__dot {
        height: 1rem;
        width: 1rem;
        border-radius: 9999px;
        background-color: var(--text-main);
    }

    .theme-toggle:focus-visible {
        outline: 2px solid var(--border-main);
        outline-offset: 2px;
    }
</style>
