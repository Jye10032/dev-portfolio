---
import type { HTMLAttributes } from 'astro/types';

/** Square bordered control for icon-only actions. Renders `<a>` when `href` is set. */
type Props = (HTMLAttributes<'a'> & { href: string }) | (HTMLAttributes<'button'> & { href?: undefined });

const { href, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag class:list={['ui-icon-button', className]} href={href} {...rest}>
    <slot />
</Tag>

<style>
    .ui-icon-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border-main);
        background-color: transparent;
        padding: 0.5rem;
        color: var(--text-main);
        text-decoration: none;
        cursor: pointer;
        transition: background-color 160ms ease;
    }

    .ui-icon-button:hover,
    .ui-icon-button:focus-visible {
        background-color: var(--bg-muted);
        text-decoration: none;
    }

    .ui-icon-button:focus-visible {
        outline: 2px solid var(--border-main);
        outline-offset: 2px;
    }
</style>
