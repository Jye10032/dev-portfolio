---
import { getCollection } from 'astro:content';
import { getAllTags } from '../utils/data-utils';

type Props = {
    active?: 'all' | 'articles' | 'notes';
};

const { active = 'all' } = Astro.props;
const posts = await getCollection('blog', ({ data }) => !data.draft && data.lang === 'zh-CN');
// getAllTags carries counts and is already ordered most-used first.
const popularTags = getAllTags(posts).slice(0, 10);

const typeLinks = [
    { id: 'all', href: '/blog', label: '全部' },
    { id: 'articles', href: '/blog/articles', label: '长文' },
    { id: 'notes', href: '/blog/notes', label: '札记' }
] as const;
---

<header class="mb-12 sm:mb-16">
    <!-- The nav already says where you are; keep the h1 for document outline only. -->
    <h1 class="sr-only">写作</h1>

    <nav class="flex flex-wrap gap-2 text-sm" aria-label="内容类型">
        {
            typeLinks.map((link) => (
                <a
                    href={link.href}
                    aria-current={active === link.id ? 'page' : undefined}
                    class:list={['px-1 py-1', active === link.id && 'font-bold no-underline']}
                >
                    {link.label}
                </a>
            ))
        }
    </nav>

    {
        popularTags.length > 0 && (
            <nav class="border-main mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 border-t pt-5 text-xs" aria-label="热门主题">
                <span class="mr-1 opacity-60">主题</span>
                {popularTags.map((tag) => (
                    <a href={`/tags/${tag.id}`} class="py-1">
                        #{tag.name}
                    </a>
                ))}
                <a class="py-1" href="/tags">
                    全部主题
                </a>
            </nav>
        )
    }
</header>
