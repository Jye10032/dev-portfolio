---
import { getCollection } from 'astro:content';
import Button from '../components/Button.astro';
import HomeStory from '../components/home/HomeStory.astro';
import PostPreview from '../components/PostPreview.astro';
import VisitorStats from '../components/home/VisitorStats.astro';
import { HOME_FOCUS_AREAS, HOME_RECOMMENDATION_IDS } from '../data/home-story';
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home-story.css';
import { getAllTags, getHomepageFocusAreas, getHomepageRecommendations, getLatestPosts, getPostsByTag } from '../utils/data-utils';
import { slugify } from '../utils/common-utils';

const posts = await getCollection('blog', ({ data }) => !data.draft && data.lang === 'zh-CN');
const recommendations = getHomepageRecommendations(posts, 3, HOME_RECOMMENDATION_IDS);
const latestPosts = getLatestPosts(
    posts.filter((post) => !recommendations.some(({ id }) => id === post.id)),
    4
);
const tags = getAllTags(posts).slice(0, 6);
const focusAreas = getHomepageFocusAreas(posts, HOME_FOCUS_AREAS);
const publishYears = posts.map(({ data }) => new Date(data.publishDate).getUTCFullYear());
const firstYear = publishYears.length > 0 ? Math.min(...publishYears) : new Date().getUTCFullYear();
const latestYear = publishYears.length > 0 ? Math.max(...publishYears) : firstYear;
const proofItems = [
    { value: `${firstYear}—${latestYear}`, label: '持续记录' },
    { value: String(posts.length), label: '公开写作' },
    { value: String(focusAreas.length), label: '持续专题' },
    { value: String(getPostsByTag(posts, slugify('题解')).length), label: '题解札记' }
];
---

<BaseLayout description={siteConfig.description} wide>
    <HomeStory recommendations={recommendations} homeNow={siteConfig.homeNow} focusAreas={focusAreas} proofItems={proofItems} avatar={siteConfig.avatar} />

    <VisitorStats />

    <!-- 最新动态 -->
    {
        latestPosts.length > 0 && (
            <section class="mb-16 sm:mb-24">
                <div class="mb-8 flex items-baseline justify-between sm:mb-12">
                    <h2 class="font-serif text-xl italic sm:text-2xl">最新</h2>
                    <Button href="/blog" class="text-sm">
                        查看全部
                    </Button>
                </div>
                <div class="space-y-8 sm:space-y-10">
                    {latestPosts.map((post) => (
                        <PostPreview post={post} headingLevel="h3" />
                    ))}
                </div>
            </section>
        )
    }

    <!-- 主题入口 -->
    {
        tags.length > 0 && (
            <section class="mb-16 sm:mb-24">
                <h2 class="mb-8 font-serif text-xl italic sm:mb-12 sm:text-2xl">主题</h2>
                <div class="flex flex-wrap gap-3">
                    {tags.map((tag) => (
                        <a
                            href={`/tags/${tag.id}`}
                            class="border-main/20 hover:bg-main hover:text-bg-main rounded-full border px-4 py-2 text-sm transition-colors"
                        >
                            #{tag.name}
                        </a>
                    ))}
                </div>
            </section>
        )
    }
</BaseLayout>

<script>
    import '../scripts/home-story';
</script>
