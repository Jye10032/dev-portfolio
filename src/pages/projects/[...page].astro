---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import Pagination from '../../components/Pagination.astro';
import ProjectShowcase from '../../components/ProjectShowcase.astro';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(sortItemsByDateDesc);
    if (projects.length === 0) return [];
    return paginate(projects, { pageSize: siteConfig.projectsPerPage ?? 8 });
}

type Props = { page: Page<CollectionEntry<'projects'>> };

const { page } = Astro.props;
---

<BaseLayout title="项目" description="项目介绍与可直接操作的在线演示。" wide>
    <header class="project-index__header">
        <h1>项目</h1>
        <p>从项目简介开始，直接体验它的功能。</p>
    </header>

    <ol class="project-index__list">
        {
            page.data.map((project, index) => (
                <li class="project-index__item">
                    <ProjectShowcase project={project} index={page.start + index + 1} />
                </li>
            ))
        }
    </ol>

    {page.lastPage > 1 && <Pagination page={page} class="project-index__pager" />}
</BaseLayout>

<style>
    .project-index__header {
        padding-block: 1rem clamp(2rem, 5vw, 4rem);
    }

    .project-index__header h1 {
        font-family: var(--font-serif);
        font-size: clamp(2.25rem, 4vw, 3.5rem);
        font-weight: 500;
        line-height: 1.2;
    }

    .project-index__header p {
        margin-top: 1rem;
        color: var(--accent-muted);
        line-height: 1.75;
    }

    .project-index__list {
        display: grid;
        margin-bottom: 3rem;
        list-style: none;
    }

    .project-index__item {
        min-width: 0;
    }

    :global(.project-index__pager) {
        margin: 4rem 0;
    }
</style>
