---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ProjectPreview from '../../components/ProjectPreview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths() {
    const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(sortItemsByDateDesc);
    const lastIndex = projects.length - 1;

    return projects.map((project, index) => ({
        params: { id: project.id },
        props: {
            project,
            olderProject: index < lastIndex ? projects[index + 1] : null,
            newerProject: index > 0 ? projects[index - 1] : null
        }
    }));
}

type Props = {
    project: CollectionEntry<'projects'>;
    olderProject: CollectionEntry<'projects'> | null;
    newerProject: CollectionEntry<'projects'> | null;
};

const { project, olderProject, newerProject } = Astro.props;
const { title, description, seo } = project.data;
const { Content } = await render(project);
const related = [newerProject, olderProject].filter((entry): entry is CollectionEntry<'projects'> => Boolean(entry));
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? description} image={seo?.image} pageType="article">
    <article class="project-detail">
        <header class="project-detail__head">
            <h1 class="project-detail__title">{title}</h1>
            {description && <p class="project-detail__lead">{description}</p>}
        </header>
        <div class="prose sm:prose-lg max-w-none">
            <Content />
        </div>
    </article>

    {
        related.length > 0 && (
            <nav class="project-detail__related" aria-label="其他项目">
                <h2 class="project-detail__related-title">其他项目</h2>
                <ol class="project-detail__related-list">
                    {related.map((entry) => (
                        <li>
                            <ProjectPreview project={entry} headingLevel="h3" />
                        </li>
                    ))}
                </ol>
            </nav>
        )
    }
</BaseLayout>

<style>
    .project-detail {
        margin-bottom: 4rem;
    }

    .project-detail__head {
        margin-bottom: 2rem;
    }

    .project-detail__title {
        font-family: var(--font-serif);
        font-size: 1.875rem;
        font-weight: 500;
        line-height: 1.25;
    }

    @media (min-width: 40rem) {
        .project-detail__title {
            font-size: 3rem;
        }
    }

    .project-detail__lead {
        margin-top: 0.75rem;
        line-height: 1.7;
        opacity: 0.85;
    }

    .project-detail__related {
        margin: 4rem 0;
        border-top: 1px solid var(--border-main);
        padding-top: 2rem;
    }

    .project-detail__related-title {
        margin-bottom: 2rem;
        font-family: var(--font-sans);
        font-size: 1.25rem;
        font-weight: 700;
    }

    .project-detail__related-list {
        display: grid;
        gap: 2.5rem;
        list-style: none;
    }
</style>
