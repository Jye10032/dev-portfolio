---
import { getCollection } from 'astro:content';
import Subscribe from '../../components/Subscribe.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPostsByTag, sortItemsByDateDesc } from '../../utils/data-utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'zh-CN')).sort(sortItemsByDateDesc);
const tags = getAllTags(posts).sort((tagA, tagB) => {
    const postCountTagA = getPostsByTag(posts, tagA.id).length;
    const postCountTagB = getPostsByTag(posts, tagB.id).length;
    return postCountTagB - postCountTagA;
});
---

<BaseLayout wide title="主题" description="浏览所有主题标签，发现感兴趣的内容" showHeader={false}>
    <section class="tag-index">
        <header class="tag-index__intro">
            <h1>主题</h1>
            <p>按关键词浏览文章与札记。</p>
        </header>
        <div class="tag-index__directory" aria-label="全部主题">
            {
                tags.map((tag) => {
                    const postCount = getPostsByTag(posts, tag.id).length;
                    return (
                        <a class="tag-index__item" href={`/tags/${tag.id}`}>
                            <span class="tag-index__name">#{tag.name}</span>
                            <span class="tag-index__count">{String(postCount).padStart(2, '0')}</span>
                        </a>
                    );
                })
            }
        </div>
    </section>
    <Subscribe class="my-16 sm:my-24" />
</BaseLayout>

<style>
    .tag-index {
        display: grid;
        grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr);
        gap: clamp(2.5rem, 8vw, 7rem);
    }

    .tag-index__intro {
        position: sticky;
        top: 5rem;
        align-self: start;
    }

    .tag-index__intro h1 {
        margin: 0;
        font-size: clamp(1.875rem, 4vw, 3rem);
        font-weight: 700;
        line-height: 1.15;
    }

    .tag-index__intro p {
        margin: 0.75rem 0 0;
        font-size: 0.9375rem;
        opacity: 0.65;
    }

    .tag-index__directory {
        border-top: 1px solid var(--border-main);
    }

    .tag-index__item {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: baseline;
        gap: 1.5rem;
        min-height: 3.5rem;
        padding: 0.9rem 0;
        border-bottom: 1px solid color-mix(in srgb, var(--border-main) 22%, transparent);
    }

    .tag-index__item:hover,
    .tag-index__item:focus-visible {
        text-decoration: none;
    }

    .tag-index__item:hover .tag-index__name,
    .tag-index__item:focus-visible .tag-index__name {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .tag-index__name {
        overflow-wrap: anywhere;
        font-size: clamp(1.125rem, 2.2vw, 1.5rem);
        line-height: 1.25;
    }

    .tag-index__count {
        font-family: monospace;
        font-size: 0.8125rem;
        opacity: 0.55;
    }

    @media (max-width: 799px) {
        .tag-index {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .tag-index__intro {
            position: static;
        }
    }
</style>
