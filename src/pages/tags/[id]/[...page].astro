---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import PostArchive from '../../../components/PostArchive.astro';
import siteConfig from '../../../data/site-config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllTags, getPostsByTag, sortItemsByDateDesc } from '../../../utils/data-utils';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'zh-CN')).sort(sortItemsByDateDesc);

    return getAllTags(posts).flatMap((tag) =>
        paginate(getPostsByTag(posts, tag.id), {
            params: { id: tag.id },
            props: { tagName: tag.name },
            pageSize: siteConfig.postsPerPage ?? 8
        })
    );
}

type Props = { page: Page<CollectionEntry<'blog'>>; tagName: string };

const { page, tagName } = Astro.props;
---

<BaseLayout title={`#${tagName}`} description={`关于「${tagName}」的所有文章`}>
    <PostArchive {page} emptyText={`还没有关于「${tagName}」的文章。`}>
        <header slot="header" class="tag-archive__head">
            <h1 class="tag-archive__title">#{tagName}</h1>
            <p class="tag-archive__count">{page.total} 篇</p>
        </header>
    </PostArchive>
</BaseLayout>

<style>
    .tag-archive__head {
        margin-bottom: 3rem;
    }

    @media (min-width: 40rem) {
        .tag-archive__head {
            margin-bottom: 4rem;
        }
    }

    .tag-archive__title {
        font-family: var(--font-sans);
        font-size: 1.875rem;
        font-weight: 700;
        line-height: 1.2;
    }

    @media (min-width: 40rem) {
        .tag-archive__title {
            font-size: 3rem;
        }
    }

    .tag-archive__count {
        margin-top: 0.5rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.8rem;
        opacity: 0.6;
    }
</style>
