---
import { getCollection } from 'astro:content';
import { timelineEntries } from '../data/timeline';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostHref } from '../utils/data-utils';

const [posts, projects] = await Promise.all([
    getCollection('blog', ({ data }) => !data.draft && data.lang === 'zh-CN'),
    getCollection('projects', ({ data }) => !data.draft)
]);
const postsById = new Map(posts.map((post) => [post.id, post]));
const projectsById = new Map(projects.map((project) => [project.id, project]));

const entries = timelineEntries.map((entry) => {
    // Fail visibly at build time rather than publish a broken or private link.
    const relatedPosts = (entry.postIds ?? []).map((id) => {
        const post = postsById.get(id);
        if (!post) throw new Error(`Timeline "${entry.id}" references an unavailable Chinese blog post: ${id}`);
        return post;
    });
    // Experiences can precede their project pages; link only published projects.
    const project = entry.projectId ? projectsById.get(entry.projectId) : undefined;

    return { ...entry, relatedPosts, project };
});

const timeline = [...new Set(entries.map(({ year }) => year))]
    .sort((a, b) => b - a)
    .map((year) => ({ year, entries: entries.filter((entry) => entry.year === year) }));
---

<BaseLayout title="时间线" description="沿着时间回看我的项目、开源实践与学习经历，以及这些经历留下的博客和思考。">
    <header class="timeline-header">
        <p class="timeline-kicker">经历与记录</p>
        <h1>时间线</h1>
        <p class="timeline-intro">做过的事，走过的路，以及沿途留下的文字。</p>
        <a class="archive-link" href="/blog/">浏览全部写作 <span aria-hidden="true">→</span></a>
    </header>

    {
        timeline.length > 0 ? (
            <div class="timeline" aria-label="个人经历时间线">
                {timeline.map((yearGroup) => (
                    <section class="timeline-year" aria-labelledby={`year-${yearGroup.year}`}>
                        <div class="year-heading">
                            <h2 id={`year-${yearGroup.year}`}>{yearGroup.year}</h2>
                        </div>

                        <ol class="year-entries" role="list">
                            {yearGroup.entries.map((entry) => (
                                <li class="timeline-entry">
                                    <article aria-labelledby={`experience-${entry.id}`}>
                                        <div class="entry-meta">
                                            {entry.month && (
                                                <time datetime={`${entry.year}-${String(entry.month).padStart(2, '0')}`}>
                                                    {String(entry.month).padStart(2, '0')} 月
                                                </time>
                                            )}
                                            <span class="entry-kind">{entry.kind}</span>
                                        </div>
                                        <h3 id={`experience-${entry.id}`}>{entry.title}</h3>
                                        <p class="entry-description">{entry.description}</p>

                                        {entry.relatedPosts.length > 0 && (
                                            <div class="entry-reading">
                                                <h4>相关阅读</h4>
                                                <ul role="list">
                                                    {entry.relatedPosts.map((post) => (
                                                        <li>
                                                            <a href={getPostHref(post)}>
                                                                <span>{post.data.title}</span>
                                                                <span class="link-arrow" aria-hidden="true">
                                                                    →
                                                                </span>
                                                            </a>
                                                        </li>
                                                    ))}
                                                </ul>
                                            </div>
                                        )}

                                        {entry.project && (
                                            <a class="project-link" href={`/projects/${entry.project.id}/`}>
                                                查看项目 <span class="sr-only">：{entry.project.data.title}</span>
                                                <span aria-hidden="true">→</span>
                                            </a>
                                        )}
                                    </article>
                                </li>
                            ))}
                        </ol>
                    </section>
                ))}
            </div>
        ) : (
            <p class="timeline-empty">经历还在整理中。</p>
        )
    }
</BaseLayout>

<style>
    .timeline-header {
        margin-bottom: 4rem;
        max-width: 38rem;
    }

    .timeline-kicker {
        margin-bottom: 0.75rem;
        color: color-mix(in srgb, var(--text-main) 60%, transparent);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
    }

    .timeline-header h1 {
        margin: 0;
        font-family: var(--font-serif);
        font-size: clamp(2rem, 5vw, 2.75rem);
        font-weight: 500;
        line-height: 1.25;
    }

    .timeline-intro {
        margin: 1rem 0;
        color: color-mix(in srgb, var(--text-main) 72%, transparent);
        font-size: 1rem;
        line-height: 1.8;
    }

    .archive-link,
    .project-link {
        display: inline-flex;
        align-items: baseline;
        gap: 0.5rem;
        color: var(--accent);
        font-size: 0.8125rem;
        line-height: 1.6;
        padding-block: 0.25rem;
    }

    .timeline {
        position: relative;
        padding-bottom: 2rem;
    }

    .timeline::before {
        position: absolute;
        top: 0.625rem;
        bottom: 2rem;
        left: 5.45rem;
        width: 1px;
        background: color-mix(in srgb, var(--border-main) 18%, transparent);
        content: '';
    }

    .timeline-year {
        display: grid;
        grid-template-columns: 4.25rem minmax(0, 1fr);
        gap: 2.5rem;
        position: relative;
    }

    .timeline-year + .timeline-year {
        margin-top: 4rem;
    }

    .year-heading {
        position: sticky;
        top: 1.5rem;
        align-self: start;
        text-align: right;
    }

    .year-heading h2 {
        margin: 0;
        font-family: var(--font-serif);
        font-size: 1.5rem;
        font-weight: 500;
        line-height: 1.1;
    }

    .year-entries {
        display: grid;
        gap: 3rem;
        min-width: 0;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .timeline-entry {
        position: relative;
        min-width: 0;
    }

    .timeline-entry::before {
        position: absolute;
        top: 0.375rem;
        left: -1.625rem;
        width: 0.625rem;
        height: 0.625rem;
        border: 2px solid var(--bg-main);
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 1px var(--accent);
        content: '';
    }

    .entry-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 0.6rem;
        color: color-mix(in srgb, var(--text-main) 62%, transparent);
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
        line-height: 1.6;
    }

    .entry-kind {
        font-weight: 600;
    }

    .entry-meta time + .entry-kind {
        border-left: 1px solid color-mix(in srgb, var(--border-main) 25%, transparent);
        padding-left: 0.75rem;
    }

    .timeline-entry h3 {
        margin: 0;
        font-family: var(--font-serif);
        font-size: 1.375rem;
        font-weight: 500;
        line-height: 1.5;
        text-wrap: pretty;
    }

    .entry-description {
        margin: 0.75rem 0 0;
        color: color-mix(in srgb, var(--text-main) 76%, transparent);
        font-size: 0.9375rem;
        line-height: 1.85;
        text-wrap: pretty;
    }

    .entry-reading {
        margin-top: 1.25rem;
        border-left: 2px solid color-mix(in srgb, var(--border-main) 15%, transparent);
        padding-left: 1rem;
    }

    .entry-reading h4 {
        margin: 0 0 0.4rem;
        color: color-mix(in srgb, var(--text-main) 60%, transparent);
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.04em;
    }

    .entry-reading ul {
        display: grid;
        gap: 0.125rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .entry-reading a {
        display: inline-flex;
        align-items: baseline;
        gap: 0.5rem;
        padding-block: 0.3rem;
        color: var(--text-main);
        font-size: 0.8125rem;
        line-height: 1.65;
    }

    .link-arrow {
        flex: none;
        color: color-mix(in srgb, var(--text-main) 55%, transparent);
    }

    .project-link {
        margin-top: 1rem;
    }

    .timeline-header a:focus-visible,
    .timeline-entry a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
        border-radius: 1px;
    }

    .timeline-empty {
        padding: 3rem 0;
        color: color-mix(in srgb, var(--text-main) 65%, transparent);
    }

    @media (max-width: 639px) {
        .timeline-header {
            margin-bottom: 3rem;
        }

        .timeline::before {
            left: 0.3rem;
        }

        .timeline-year {
            display: block;
            padding-left: 1.75rem;
        }

        .timeline-year + .timeline-year {
            margin-top: 3rem;
        }

        .year-heading {
            position: static;
            margin-bottom: 1.75rem;
            text-align: left;
        }

        .year-entries {
            gap: 2.5rem;
        }

        .timeline-entry::before {
            left: -1.75rem;
        }

        .timeline-entry h3 {
            font-size: 1.25rem;
        }

        .entry-reading {
            padding-left: 0.75rem;
        }
    }
</style>
