---
import Layout from '../layouts/main.astro';
import type { MarkdownInstance } from 'astro';

type PostFrontmatter = {
  title: string;
  author?: string;
  date?: string;
};

const posts = Object.values(
  import.meta.glob<MarkdownInstance<PostFrontmatter>>('../posts/*.md', {
    eager: true,
  })
);

const postsList = posts.filter(Boolean);
const [featuredPost] = postsList;
---

<Layout>
    <p>这里是文章列表。</p>
  <!-- 
  这里显示文章大字的标题和作者信息  
  {featuredPost && (
    <>
      <h1>{featuredPost.frontmatter.title}</h1>
      <p>作者：{featuredPost.frontmatter.author ?? '佚名'}</p>
    </>
  )} -->

  <section>
    <h2>文章归档</h2>
    <ul>
      {postsList.map((post) => {
        const href = post.url ?? '#';
        return (
          <li>
            <a href={href}>{post.frontmatter.title}</a>
            <p>作者：{post.frontmatter.author ?? '佚名'}</p>
            <p>发布日期：{post.frontmatter.date}</p>
            <p>文章简介：{post.frontmatter.description}</p>
          </li>
        );
      })}
    </ul>
  </section>
</Layout>